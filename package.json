{
  "name": "monblan",
  "version": "0.1.0-beta.2",
  "description": "Motion-based Layered Annotator",
  "main": "dist/main/main.js",
  "author": "Kazuya Okamura",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Kazuyai/MONBLAN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kazuyai/MONBLAN.git"
  },
  "bugs": {
    "url": "https://github.com/Kazuyai/MONBLAN/issues"
  },
  "scripts": {
    "dev": "concurrently -k --names VITE,TS,ELECTRON -c blue,yellow,green \"yarn dev:react\" \"yarn dev:main\" \"yarn dev:electron\"",
    "dev:react": "vite --port 3001 --strictPort",
    "dev:main": "tsc-watch -p tsconfig.main.json --onSuccess \"echo TS build ready\"",
    "dev:electron": "wait-on http://localhost:3001 && wait-on dist/main/main.js && cross-env NODE_ENV=development electron .",
    "build": "yarn build:react && yarn build:electron",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "dist": "yarn build && electron-builder",
    "dist:windows": "yarn build && electron-builder --win nsis --x64",
    "dist:dir": "yarn build && electron-builder --dir",
    "pack": "electron-builder --dir",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,scss,md}",
    "prettier:check": "prettier --check src/**/*.{ts,tsx,js,jsx,json,css,scss,md}"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.8.0",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^46.9.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "jsdom": "24.1.3",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.4",
    "vitest": "1.6.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-debug": "^3.2.0",
    "electron-log": "^4.4.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^10.0.0"
  },
  "build": {
    "appId": "com.monblan.app",
    "productName": "MONBLAN",
    "copyright": "Copyright © 2026 Kazuya Okamura",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "API",
        "to": "runtime/API",
        "filter": [
          "**/*",
          "!AlphaPose/**/*",
          "!MotionBERT/**/*",
          "!venv/**/*",
          "!out/**/*",
          "!build/**/*",
          "!dist/**/*",
          "!__pycache__/**/*",
          "!**/__pycache__/**/*",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.pyd",
          "!**/*.pth",
          "!**/*.pt",
          "!**/*.bin",
          "!**/*.onnx",
          "!**/*.npy",
          "!**/*.npz",
          "!api_log.txt"
        ]
      },
      {
        "from": "scripts",
        "to": "runtime/scripts",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "config",
        "to": "runtime/config",
        "filter": [
          "**/*.json"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "licenses/NOTICE"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "MONBLAN-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MONBLAN",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
